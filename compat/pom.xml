<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.ltslab</groupId>
  <artifactId>lts-for-spring-compat</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>LTS for Spring compatibility tooling</name>
  <description>Redirects upstream Spring and Reactor coordinates to the LTS for Spring artifacts. Not affiliated with Broadcom or the Spring team.</description>
  <url>https://github.com/ltslab/lts-for-spring</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>ltslab contributors</name>
      <organizationUrl>https://github.com/ltslab/lts-for-spring</organizationUrl>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/ltslab/lts-for-spring</url>
    <connection>scm:git:https://github.com/ltslab/lts-for-spring.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ltslab/lts-for-spring.git</developerConnection>
  </scm>

  <modules>
    <module>maven-extension</module>
    <module>gradle-plugin</module>
  </modules>

  <properties>
    <revision>0-SNAPSHOT</revision>
    <!-- Generated by scripts/release.py: upstream group:artifact = ltslab group:artifact:version -->
    <coordinates.dir>${project.basedir}/../../work/compat</coordinates.dir>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${coordinates.dir}</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.7.3</version>
        <configuration>
          <flattenMode>ossrh</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
